# secrets / environment
.env
.env.local
*.pem
*.key
# tfvars は秘密値を含むため全て無視(雛形 *.tfvars.example のみ追跡)
*.tfvars
!*.tfvars.example

# python
.venv/
.coverage
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/

# node
node_modules/
dist/
# ORMワンクリック(INFRA-03): SPAビルド成果物のみ追跡しTerraformでバケットへ配信(release.ymlが更新)
!/packages/web/dist/
!/packages/web/dist/**
.vite/

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# misc
*.log
.DS_Store
tmp/

# Obsidian 出力先の絶対パス（環境依存・共有しない・ハンドオフ ch.5）
.obsidian-dir

# spike audio artifacts (archived)
docs/archive/spikes/data/*.mp3
docs/archive/spikes/data/*.wav
.playwright-mcp/

# 個人フィードバック原文はリポジトリに含めない(ローカル管理)
/docs/feedbacks/

# loop 成果物（stage-runner 統合で混入防止）
.current_run_id

# 人間向け報告書 HTML（ADR-0018）。報告書は仕様でも証跡でもなく「読み物」なので、
# 原本は runs/ に生成しつつ git には入れず、報告パイプで各自の閲覧環境へ配置する。
runs/**/*.html
docs/verification/*.html

# 無人 claude 実行ログ（ヘッドレス委譲・ハンドオフ ch.4）
.agent-runs/

# SPIKE-M1 の検証リソース台帳（OCID を含む運用状態。証跡ではない）
.spike-m1-registry.json
