# OCI 環境依存値の雛形。実値は .env に置く（コミット禁止）
OCI_REGION=us-chicago-1
# OCI ログイン方式: config_file(既定・ローカルの ~/.oci/config) | resource_principal(配備時・Terraform が設定) | instance_principal
# ローカル開発は未設定=config_file でよい。OCI_PROFILE 空=DEFAULT プロファイル。
AUTH_MODE=
OCI_PROFILE=
COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxx
OS_NAMESPACE=your-object-storage-namespace
# OCIR の名前空間（通常は OS_NAMESPACE と同じ）。ops/ のデプロイ用。未設定なら OS_NAMESPACE を使う
OCIR_NAMESPACE=

# OpenAI互換エンドポイント（リージョンから導出可能だが明示）
GENAI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1

# FIX-47: DP状態API(Files/Conversations等)の OpenAi-Project ヘッダに使う GenerativeAiProject OCID。
# 空なら compartment 内の ACTIVE project を自動検出（project OCIDはリージョン別）。
# PROJECT_AUTOCREATE=true なら project が無いとき自動作成する（要 manage generative-ai-project。
# 公開ORMスタックは既定で有効。ローカル/ベア実行の既定は false=検出のみ）
PROJECT_OCID=
PROJECT_AUTOCREATE=false

# SPIKE-04 (ADB)
ADB_ADMIN_PASSWORD=
ADB_OCID=
# アプリ/読取スキーマ（開発者ごとにE2E環境を分ける場合に上書き。既定は共有スキーマ）
# 例: ADB_USER=JETUSE_ALICE / ADB_QUERY_USER=JETUSE_ALICE_Q（ops/setup-dev-schema.py で作成）
ADB_USER=JETUSE_APP
ADB_QUERY_USER=JETUSE_QUERY
# DB の中で DBMS_CLOUD / DBMS_CLOUD_AI が使う資格情報(ADR-0021)。開発も配備も ADB 自身の身分に統一。
# 空=既定 OCI$RESOURCE_PRINCIPAL。ops/setup-dev-schema.py が ENABLE_RESOURCE_PRINCIPAL 済みであること。
SELECT_AI_CREDENTIAL=OCI$RESOURCE_PRINCIPAL

# SPIKE-02 (SSE)
APIGW_ENDPOINT=

# INFRA-02/SP2-04 (OIDC / 専用Identity Domain)。AUTH_REQUIRED=true では3値全て必須(不備は500)。
# issuer/JWKS は当該ドメインの discovery(<domain_url>/.well-known/openid-configuration)の値を
# そのまま使う(issuer は IdP 世代で異なるため固定値を書かない — specs/18 §5.1)。
# audience は discovery からは得られない: アプリ登録の primary audience か実トークンの aud 実測値。
AUTH_REQUIRED=false
OIDC_ISSUER=<discoveryのissuerをそのまま>
OIDC_JWKS_URL=<discoveryのjwks_uriをそのまま>
OIDC_AUDIENCE=<アプリ登録のprimary audience または実トークンのaud実測値>
# SP3-03 (ADR-0023 §3.5): 生成 SPA の app-session Cookie/一回性コードの HMAC 秘密鍵。
# AUTH_REQUIRED=true の配信で必須(空なら Cookie 認証経路は fail-closed で無効)。ランダムな長い値。
APP_SESSION_SECRET=<openssl rand -hex 32 などの高エントロピー値・コミットしない>

# VOICE-01 (議事録): 音声・文字起こし結果のバケット(空なら機能無効)
SPEECH_BUCKET=jetuse-dev-speech

# SP2-02 (箱ライフサイクル / specs/18): RAG 上限
# demo 箱あたりのファイル数上限(既定 20)
DEMO_MAX_RAG_FILES=20
# アプリ全体の Files 総数上限。未設定=無効(挙動不変)。Internal 配備でテナンシ File 枠を守る
# ときだけ下行のコメントを外して正の整数を設定する(予約 ledger の reserve が超過で 422 を返す)。
# 注意: 空文字 `RAG_FILES_TOTAL_LIMIT=` は int|None 検証に失敗し起動不能 — 無効化は「行ごと省略」。
# RAG_FILES_TOTAL_LIMIT=2000
# VPD(行レベル分離)。既定 false=Public/従来互換(未配備環境で dataset/dbchat が壊れない)。
# Internal/デモテナンシ配備のみ true(人間ゲートで VPD セットアップ済みが前提)。
VPD_ENABLED=false

# SP3-03: 生成コンテナ(鍵レス)から見た署名プロキシの実エンドポイント(必須・環境依存)。
# 例: rootless podman(slirp4netns)なら host gateway。値はコードにコミットしない。
GENERATION_PROXY_URL=http://<proxy-host-as-seen-from-container>:8765/v1

# SP3-06: 生成 gpt-5 系(共有テナンシ)の OCI CLI auth プロファイルと compartment OCID。
# 空 = 共有テナンシモデルは使用不可(fail-closed: プロキシ 403 / runtime は起動前に明示失敗)。
# 実行・課金は共有テナンシ側(docs/verification/SP3-06.md)。値はコミット禁止。
GEN_SHARED_PROFILE=<~/.oci/config のプロファイル名>
GEN_SHARED_COMPARTMENT_OCID=ocid1.compartment.oc1..xxxxxxxx

# SP3-09(デプロイ環境のみ — dev-app tf が配線するためローカル .env では通常設定しない):
# 鍵材料 JSON を置く Vault シークレットの OCID。設定時は GEN_SHARED_PROFILE より優先。
# GEN_SHARED_SECRET_OCID=ocid1.vaultsecret.oc1..xxxxxxxx
# VID-01 (映像): 映像本体・サムネイルのバケット(空なら機能無効=503)
VIDEO_BUCKET=jetuse-dev-video

# ops/setup-*.py が DDL 前に対象 ADB を照合するための値(ADR-0021 / RP-01)。
# ADB_OCID は必須。ADB がコンパートメント階層の子(例 jetuse:dev)にある場合は
# その OCID を ADB_COMPARTMENT_OCID に置く(未設定なら COMPARTMENT_OCID と完全一致を要求)。
ADB_COMPARTMENT_OCID=
# 接続後の SQL 往復の上限(ms)。0 以下は拒否(無期限待ちを作らない)。
ADB_CALL_TIMEOUT_MS=600000

# TOOL-02 の実環境 E2E だけが使う。JetUse が送ったヘッダを **相手の側から** 確かめるための
# 公開 https エコー先(受け取ったヘッダを JSON で返すもの)。宛先を承認・差し替えできるよう
# コードに焼かない。未設定なら spikes/tool02/e2e.py は実行を断る(fail-closed)。
TOOL02_ECHO_URL=

# TOOL-03 の実環境 E2E だけが使う。JetUse が送った**ボディ**を相手の側から確かめるための
# 公開 https エコー先(受け取った JSON をそのまま返すもの)。入れ子・配列が形のまま届いたかは
# 相手が受け取った本文を見るしかない。宛先を承認・差し替えできるようコードに焼かない。
# 未設定なら spikes/tool03/e2e.py は実行を断る(fail-closed)。**秘密は送らない**
# (このシナリオに認証は不要なので、検証用トークンすら作らない)。
TOOL03_ECHO_URL=

# AGT-04: エージェントのツール往復(ホップ)上限。1 ホップ = モデル 1 往復。
# 未設定なら AGENT_MAX_TOOL_HOPS_DEFAULT。天井(AGENT_MAX_TOOL_HOPS_CEILING)を超える値は
# クランプせず拒否する(エージェント要求が 400 になる)。根拠は ADR-0025。
AGENT_MAX_TOOL_HOPS=

# AGT-05: 文書検索(adb 経路の rag_search)の回数上限。**ホップとは別枠**で数える
# (検索はホップを消費しない)。未設定なら AGENT_MAX_DOC_SEARCHES_DEFAULT。
# 上限に達しても手続きは打ち切らず、検索ツールだけ外して続ける。天井
# (AGENT_MAX_DOC_SEARCHES_CEILING)を超える値はクランプせず拒否する。根拠は ADR-0026。
AGENT_MAX_DOC_SEARCHES=

# AGT-05 の実環境 E2E だけが使う。文書検索を挟みながら業務 API を 8 本呼ぶ手続きを
# 実物の相手で確かめるための公開 https エコー先。未設定なら spikes/agt05/e2e.py は実行を断る
# (承認していない宛先へは送らない)。**秘密は送らない**(このシナリオに認証は不要)。
AGT05_ECHO_URL=

# AGT-04 の実環境 E2E だけが使う。多段の業務フロー(HTTP ツールを順に呼ぶ)を実物の相手で
# 確かめるための公開 https エコー先。未設定なら spikes/agt04/e2e.py は実行を断る。
AGT04_ECHO_URL=

# AGT-06: エージェントのモデル比較 E2E で使う公開 https エコー(受け取った本文をそのまま返す)
AGT06_ECHO_URL=

# AGT-06 の実機 probe / 比較に使う（シカゴの GenAI project OCID）。
# **project はリージョンごと**で、大阪の project をシカゴへ送ると 400 Invalid OpenAI project。
# 非 OpenAI モデル（Grok / Gemini）を Responses API で呼ぶには OpenAi-Project ヘッダが要る。
AGT06_CHICAGO_PROJECT_OCID=

# Identity Domain の URL（テナンシ固有）。ops/ のデプロイ用。
# 例: https://idcs-xxxxxxxx.identity.oraclecloud.com
IDENTITY_DOMAIN_URL=

# --- ORM スタック（ADR-0031。ops/orm-stack.sh が読む） ----------------------
TENANCY_OCID=
INTERNAL_DEV_COMPARTMENT_OCID=
PUBLIC_DEV_COMPARTMENT_OCID=
