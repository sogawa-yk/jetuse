+    attempts = {"n": 0}
+
+    def flaky(content, **kw):
+        attempts["n"] += 1
+        if attempts["n"] == 1:
+            raise docunderstand.OcrError("一時的な失敗")
+        return {"pages": [["OCR1行目"]]}
+
+    monkeypatch.setattr(docunderstand, "ocr", flaky)
+    pdf = build_pdf([""])
+    with pytest.raises(extract_scan.OcrUnavailable):
+        extract_scan.page_texts("s.pdf", pdf)
