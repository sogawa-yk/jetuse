+    if len(missing) > MAX_OCR_PAGES:
+        raise ScanLimitError(
+            "ocr_pages",
+            f"OCR が要るページ数が上限を超えました({len(missing)} > {MAX_OCR_PAGES} ページ)。"
+            "ファイルを分割してください",
