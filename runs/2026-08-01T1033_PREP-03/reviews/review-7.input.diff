+
+    monkeypatch.setattr(extract_scan, "OCR_WAIT_SECONDS", 0.05)
+    release = threading.Event()
+    calls: list[str] = []
+
+    def ocr(content, **kw):
+        calls.append("call")
+        if len(calls) == 1:
+            release.wait(timeout=5)
+            return {"pages": [["古い結果"]]}
+        return {"pages": [["新しい結果"]]}
+
+    monkeypatch.setattr(docunderstand, "ocr", ocr)
+    pdf = build_pdf([""])
+    out: list[list[str]] = []
