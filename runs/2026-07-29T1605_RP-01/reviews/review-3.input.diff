+# ------------------------------------------------------------------ 所有権の台帳
+def ledger() -> dict:
+    return json.loads(LEDGER.read_text()) if LEDGER.exists() else {}
+
+
+def write_ledger(data: dict) -> None:
+    LEDGER.write_text(json.dumps(data, indent=2, ensure_ascii=False, default=str) + "\n")
+
+
+def record(key: str, value) -> None:
+    data = ledger()
+    data[key] = value
+    write_ledger(data)
+
+
+def forget(key: str) -> None:
+    """削除できたものは台帳から落とす（stale 台帳で同名の別リソースを掴まないため）。"""
+    data = ledger()
+    if data.pop(key, None) is not None:
+        write_ledger(data)
+
+
+def user_created_at(cur, user: str) -> str | None:
+    cur.execute("SELECT TO_CHAR(created, 'YYYY-MM-DD HH24:MI:SS') FROM dba_users"
+                " WHERE username = :u", u=user)
+    row = cur.fetchone()
+    return row[0] if row else None
+
+
+def read_marker(cur) -> str | None:
+    try:
+        cur.execute(f"SELECT token FROM {SCHEMA}.{MARKER_TABLE}")
+    except oracledb.DatabaseError:
+        return None
+    row = cur.fetchone()
+    return row[0] if row else None
+
+
+def capture_ownership() -> None:
+    """**作成直後に**所有証跡を台帳へ入れる（記録前に落ちて孤児になるのを防ぐ）。
+
+    作成時刻は秒精度で、同名スキーマを作り直されると衝突しうる。そこで ADMIN 権限で
+    スキーマ内にこの run 固有の乱数トークンを書いた表を置き、これも照合対象にする。
+    """
+    conn = admin()
+    try:
+        cur = conn.cursor()
+        data = ledger()
+        for key, user in (("schema", SCHEMA), ("query_schema", QRY_SCHEMA)):
+            created = user_created_at(cur, user)
+            if created and key not in data:
+                data[key] = {"name": user, "created": created}
+                print(f"  台帳に記録: {user}（作成時刻 {created}）")
+        if "schema" in data and not data["schema"].get("marker"):
+            token = secrets.token_hex(16)
+            cur.execute(f"CREATE TABLE {SCHEMA}.{MARKER_TABLE} (token VARCHAR2(64))")
+            cur.execute(f"INSERT INTO {SCHEMA}.{MARKER_TABLE} VALUES (:t)", t=token)
+            conn.commit()
+            data["schema"]["marker"] = token
+            print(f"  この run のマーカー表を作成: {SCHEMA}.{MARKER_TABLE}")
+        write_ledger(data)
+    finally:
+        conn.close()
+
+
+def verify_owned(cur) -> tuple[bool, str]:
+    """検証用スキーマが**この run が作ったもの**かを、破壊操作の前に照合する。"""
+    entry = (ledger().get("schema") or {})
+    if entry.get("name") != SCHEMA:
+        return False, "台帳に検証用スキーマの記録が無い"
+    created = user_created_at(cur, SCHEMA)
+    if created is None:
+        return False, f"{SCHEMA} は存在しない"
+    if entry.get("created") != created:
+        return False, f"{SCHEMA} の作成時刻が台帳と違う（作り直されている）"
+    marker = read_marker(cur)
+    if not marker or marker != entry.get("marker"):
+        return False, f"{SCHEMA} のマーカーが台帳と一致しない"
+    return True, f"{SCHEMA} はこの run が作ったもの（作成時刻・マーカー一致）"
+
+
+def bucket_identity(osc, ns: str):
+    """バケットの「作った証拠」。名前だけでは再作成された別バケットと区別できない。"""
+    import oci
+    try:
+        b = osc.get_bucket(ns, BUCKET).data
+    except oci.exceptions.ServiceError as e:
+        if e.status == 404:
+            return None
+        raise
+    return {"name": b.name, "etag": b.etag, "time_created": str(b.time_created)}
