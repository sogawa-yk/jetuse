+
+def oci_args() -> dict:
+    from jetuse_core.oci_auth import sdk_signer_args
+    args = sdk_signer_args(env("OCI_REGION"))
+    args.setdefault("config", {})
+    args["config"] = {**args["config"], "region": env("OCI_REGION")}
+    return args
