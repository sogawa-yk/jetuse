@@ -0,0 +1,79 @@
+"""RAGM-02 のタスク専用スキーマ `JETUSE_RAGM02` を共有 loop ADB に作る（冪等）。
+
+ADB は増やさない（並行タスク RAGM-01 と共有し、スキーマだけで隔離する）。
+権限は ops/setup-dev-schema.py と同じ構成 + ベクタ系（`DBMS_VECTOR_CHAIN`）。
+DB 内の資格情報は `OCI$RESOURCE_PRINCIPAL` に統一する（ADR-0021。API キーを DB へ焼かない）。
+
+実行: .venv/bin/python spikes/ragm02/setup_schema.py
+片付け: .venv/bin/python spikes/ragm02/teardown.py --yes
+"""
+
+import re
+import sys
+
+import oracledb
+
+from common import (
+    SCHEMA,
+    adb,
+    banner,
+    connect_admin,
+    owned_key,
+    record_owned,
+    schema_key,
+    secret,
+)
+
+
+def _redact(sql: str) -> str:
+    return re.sub(r'IDENTIFIED BY ".*"', 'IDENTIFIED BY "***"', sql)
+
+
+def _try(cur: oracledb.Cursor, sql: str, *, ignore: tuple[str, ...] = ()) -> None:
+    shown = _redact(sql)
+    try:
+        cur.execute(sql)
+        print(f"  ok: {shown[:78]}")
+    except oracledb.DatabaseError as e:
+        msg = str(e)
+        if any(code in msg for code in ignore):
+            print(f"  skip: {shown[:60]} ({msg.splitlines()[0]})")
+            return
+        raise
+
+
+def main() -> None:
+    pw = secret("schema_password", generate=True)
+    banner(f"ADMIN: ensure {SCHEMA}")
+    admin = connect_admin()  # 接続先ガード（承認済みコンパートメントの loop ADB か）を内部で通す
+    cur = admin.cursor()
+    cur.execute("SELECT banner_full FROM v$version")
+    print("db:", cur.fetchone()[0])
+
+    cur.execute("SELECT COUNT(*) FROM all_users WHERE username = :u", u=SCHEMA)
+    exists = cur.fetchone()[0] > 0
+    if exists and schema_key(admin) != owned_key():
+        sys.exit(
+            f"ユーザー {SCHEMA} は既に存在するが台帳に無い。別用途 / 別タスクのスキーマを"
+            " 書き換える恐れがあるため中止する（先に teardown するか、台帳を確認すること）。"
+        )
+    if not exists:
+        adb.assert_password(SCHEMA, pw)
+        _try(cur, f'CREATE USER {SCHEMA} IDENTIFIED BY "{pw}"')
+        record_owned(schema_key(admin))
+    else:
+        print(f"  既存の {SCHEMA} を再利用（台帳と一致）")
+
+    _try(cur, f"GRANT CREATE SESSION, RESOURCE, CREATE VIEW TO {SCHEMA}")
+    _try(cur, f"ALTER USER {SCHEMA} QUOTA UNLIMITED ON DATA")
+    for pkg in ("DBMS_CLOUD", "DBMS_CLOUD_AI", "DBMS_CLOUD_PIPELINE", "DBMS_VECTOR_CHAIN"):
+        _try(cur, f"GRANT EXECUTE ON {pkg} TO {SCHEMA}", ignore=("ORA-04043",))
+    adb.append_acl(cur, SCHEMA)
+    adb.enable_resource_principal(cur, SCHEMA)
+    admin.commit()
+    admin.close()
+    print("\ndone")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/spikes/ragm02/teardown.py b/spikes/ragm02/teardown.py
new file mode 100644
index 0000000..dd44280
--- /dev/null
+++ b/spikes/ragm02/teardown.py
@@ -0,0 +1,61 @@
+"""RAGM-02 の検証用リソースを片付ける（既定は dry-run。実削除は `--yes`）。
+
+消すのは**台帳（`RAGM02_HOME/ledger.json`）と一致したスキーマだけ**。一致しなければ
+何も消さずに中止する（並行タスク RAGM-01 や他人の同名スキーマを壊さないため。
+SPIKE-M1 では台帳ゲートの無い teardown が検証スキーマを実際に消す事故を起こしている）。
+
+実行: PYTHONPATH=spikes/ragm02:packages/api .venv/bin/python spikes/ragm02/teardown.py [--yes]
+"""
+
+import sys
+
+import oracledb
+
+from common import SCHEMA, banner, connect_admin, owned_key, schema_key
+
+
+def main() -> None:
+    apply = "--yes" in sys.argv
+    admin = connect_admin()
+    cur = admin.cursor()
+    cur.execute("SELECT COUNT(*) FROM all_users WHERE username = :u", u=SCHEMA)
+    if cur.fetchone()[0] == 0:
+        print(f"{SCHEMA} は存在しない（片付け済み）")
+        return
+    key, owned = schema_key(admin), owned_key()
+    if key != owned:
+        sys.exit(f"台帳と一致しないため中止する（何も削除していない）。\n"
+                 f"  実物: {key}\n  台帳: {owned or '(空)'}")
+    print(f"  台帳と一致: {key}")
+
+    cur.execute("SELECT object_type, COUNT(*) FROM all_objects WHERE owner = :u "
+                "GROUP BY object_type ORDER BY 1", u=SCHEMA)
+    print("  削除対象のオブジェクト:", cur.fetchall())
+    if not apply:
+        print(f"\ndry-run。実削除は --yes を付けて実行する（DROP USER {SCHEMA} CASCADE）")
+        return
+
+    banner(f"DROP USER {SCHEMA} CASCADE")
+    cur.execute(f"DROP USER {SCHEMA} CASCADE")
+    # ACL は principal を消しても残るので明示的に落とす
+    try:
+        cur.execute("BEGIN DBMS_NETWORK_ACL_ADMIN.REMOVE_HOST_ACE("
+                    "host => '*', ace => xs$ace_type(privilege_list => "
+                    "xs$name_list('http','connect','resolve'), principal_name => :p, "
+                    "principal_type => xs_acl.ptype_db), remove_empty_acl => TRUE); END;",
+                    p=SCHEMA)
+    except oracledb.DatabaseError as e:
+        print("  ACL 削除はスキップ:", str(e).splitlines()[0])
+    admin.commit()
+
+    cur.execute("SELECT COUNT(*) FROM all_users WHERE username = :u", u=SCHEMA)
+    left = cur.fetchone()[0]
+    cur.execute("SELECT COUNT(*) FROM dba_host_aces WHERE principal = :p", p=SCHEMA)
+    acl_left = cur.fetchone()[0]
+    print(f"  削除後の再照会: ユーザー {left} 件 / ACL {acl_left} 件（どちらも 0 が期待値）")
+    admin.close()
+    sys.exit(0 if left == 0 else 1)
+
+
+if __name__ == "__main__":
+    main()
