+++ b/spikes/ragm02/scale_appshape.py
@@ -0,0 +1,106 @@
+"""スケール検証・第3ラウンド: **実装どおりの形**（017 の索引 + owner 絞り込み）で測り直す。
+
+第2ラウンドで分かったこと: メタデータ列に通常索引が無いと、WHERE 付きベクタ検索は
+全件走査＋厳密検索に倒れる。索引を足すと `VECTOR INDEX HNSW SCAN PRE-FILTER` になる。
+
+ただし第2ラウンドの索引は検証用の当て物（`(current_version, kind)` 等）で、実装が作る
+索引（`(owner_sub, ...)` 先頭）とは違う。アプリの検索は必ず `owner_sub` で絞るので、
+**マイグレーション 017 の CREATE INDEX をそのまま**（表名だけ読み替えて）張り、
+アプリと同じ形の WHERE で計画と再現率を測る。ここがずれていると「実装で効く」根拠にならない。
+
+実行: PYTHONPATH=spikes/ragm02:packages/api .venv/bin/python spikes/ragm02/scale_appshape.py
+"""
+
+import array
+import json
+import os
+import pathlib
+
+import oracledb
+
+from common import banner, connect_schema
+from fixtures import queries
+from scale_check import MIGRATION, TABLE, TOP_K, embed_all
+from scale_filters import plan_for, recall_vs_exact
+
+OWNER = "scale-owner"  # scale_check.py が投入した owner_sub
+
+# アプリの検索が実際に出す形（`rag_adb.build_where()` は必ず owner_sub を入れる）
+APP_FILTERS = [
+    ("G0 owner のみ", "WHERE owner_sub = :o", {}),
+    ("G1 owner + 版フィルタ", "WHERE owner_sub = :o AND current_version = 'Y'", {}),
+    ("G2 owner + 版 + 分類",
+     "WHERE owner_sub = :o AND current_version = 'Y' AND kind = 'constraint'", {}),
+    ("G3 owner + 版 + ファイル指定",
+     "WHERE owner_sub = :o AND current_version = 'Y' AND doc_file = :f",
+     {"f": "サンプル業務仕様書_0000.xlsx"}),
+]
+
+
+def migration_indexes() -> list[str]:
+    """017 の CREATE INDEX を検証表向けに読み替えて返す（定義を書き写さない）。"""
+    out = []
+    for stmt in MIGRATION.read_text().split(";"):
+        s = stmt.strip()
+        if s.upper().startswith("CREATE INDEX"):
+            out.append(s.replace("idx_rag_adb_chunks", f"{TABLE}_APP")
+                        .replace("rag_adb_chunks", TABLE))
+    return out
+
+
+def main() -> None:
+    conn = connect_schema()
+    conn.call_timeout = 900_000
+    cur = conn.cursor()
+    cur.execute(f"SELECT COUNT(*) FROM {TABLE} WHERE owner_sub = :o", o=OWNER)
+    rows = cur.fetchone()[0]
+    print(f"対象: {TABLE} / owner={OWNER} / {rows} 行")
+
+    banner("① 第2ラウンドの当て物索引を外し、017 の索引を張る")
+    for idx in (f"{TABLE}_META_IDX", f"{TABLE}_FILE_IDX"):
+        try:
+            cur.execute(f"DROP INDEX {idx}")
+            print(f"  dropped {idx}")
+        except oracledb.DatabaseError as e:
+            if "ORA-01418" not in str(e):
+                raise
+    for ddl in migration_indexes():
+        try:
+            cur.execute(ddl)
+            print(f"  ok: {ddl}")
+        except oracledb.DatabaseError as e:
+            print(f"  skip: {str(e).splitlines()[0]}")
+    cur.execute("BEGIN DBMS_STATS.GATHER_TABLE_STATS(USER, :t); END;", t=TABLE)
+    print("  統計採取: done")
+
+    qs = queries(int(os.environ.get("RAGM02_SCALE_QUERIES", "20")))
+    qvecs = [array.array("f", v)
+             for v in embed_all([q["q"] for q in qs], input_type="SEARCH_QUERY")]
+
+    out: dict = {"rows": rows, "owner": OWNER, "queries": len(qvecs),
+                 "indexes": migration_indexes(), "by_filter": []}
+    for label, where, extra in APP_FILTERS:
+        banner(f"② {label}")
+        binds = {"o": OWNER, **extra}
+        p = plan_for(conn, _sql(where), {"q": qvecs[0], **binds}, label)
+        m = recall_vs_exact(cur, qvecs, where, binds)
+        print(f"  recall@{TOP_K} 平均 {m['recall_at_10_mean']} / 最低 {m['recall_at_10_min']} /"
+              f" 近似 {m['approx_ms_median']} ms / 厳密 {m['exact_ms_median']} ms")
+        out["by_filter"].append({"filter": label, "vector_index_used": p["vector_index_used"], **m})
+
+    banner("③ まとめ（JSON）")
+    print(json.dumps(out, ensure_ascii=False, indent=2, default=str))
+    dest = os.environ.get("RAGM02_APPSHAPE_JSON")
+    if dest:
+        pathlib.Path(dest).write_text(json.dumps(out, ensure_ascii=False, indent=2, default=str))
+        print(f"  wrote {dest}")
+    conn.close()
+
+
+def _sql(where: str) -> str:
+    return (f"SELECT chunk_id FROM {TABLE} {where} "
+            f"ORDER BY VECTOR_DISTANCE(embedding, :q, COSINE) FETCH APPROX FIRST {TOP_K} ROWS ONLY")
+
+
+if __name__ == "__main__":
+    main()
