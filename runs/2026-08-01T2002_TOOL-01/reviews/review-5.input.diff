+    "https://10.0.0.5/x",                   # 私有レンジ
+    "https://[::1]/x",                      # IPv6 ループバック
+    "https://user:pw@api.example.com/x",    # URL に認証情報
+])
+def test_validate_url_rejects_dangerous(url):
