@@ -0,0 +1,135 @@
+"""SPIKE-M1 が作った検証用リソースを片付ける（tasks/SPIKE-M1.md「作ったら片付ける」）。
+
+対象（これ以外は触らない）:
+  - ADB: ベクトル索引 / プロファイル / 表 / 資格証明。最後に ADMIN で
+    スキーマ JETUSE_SPIKE_M1 を DROP
+  - Object Storage: バケット jetuse-spike-m1（jetuse-spike- 接頭辞）配下の全オブジェクトとバケット
+
+既定は dry-run。実際に消すには --yes を付ける（CLAUDE.md「破壊的スクリプトは明示フラグ必須」）。
+実行: PYTHONPATH=spikes/spike_m1 .venv/bin/python spikes/spike_m1/teardown.py --yes
+"""
+
+import sys
+
+import oracledb
+
+from common import CRED, SCHEMA, VEC_CRED, assert_target, banner, connect_admin, connect_spike
+from method_a_vector_store import VS_NAME, _clients
+from method_b_select_ai import BUCKET, INDEX, PROFILE, _os_client
+from method_c_own_index import TABLE
+
+APPLY = "--yes" in sys.argv
+PROJECT_NAME = "jetuse-spike-m1-project"   # method_a 用に作った GenAI プロジェクト
+
+
+def _run(cur: oracledb.Cursor, label: str, sql: str) -> None:
+    if not APPLY:
+        print(f"  [dry-run] {label}")
+        return
+    try:
+        cur.execute(sql)
+        print(f"  ok: {label}")
+    except oracledb.DatabaseError as e:
+        print(f"  skip: {label} ({str(e).splitlines()[0]})")
+
+
+def drop_bucket() -> None:
+    banner(f"Object Storage: {BUCKET}")
+    cli = _os_client()
+    ns = cli.get_namespace().data
+    try:
+        names = [o.name for o in cli.list_objects(ns, BUCKET).data.objects]
+    except Exception as e:  # noqa: BLE001 - 既に無いなら何もしない
+        print(f"  bucket 参照不可（既に無い?）: {type(e).__name__} {str(e)[:80]}")
+        return
+    print(f"  objects: {len(names)}")
+    if not APPLY:
+        print("  [dry-run] delete_object x N + delete_bucket")
+        return
+    for n in names:
+        cli.delete_object(ns, BUCKET, n)
+    cli.delete_bucket(ns, BUCKET)
+    print(f"  deleted bucket {BUCKET}")
+
+
+def drop_vector_store() -> None:
+    """方式①で作った Vector Store / Files / GenAI プロジェクトを消す。"""
+    banner(f"OCI Vector Store: {VS_NAME} + GenAI プロジェクト")
+    cp, dp = _clients()
+    vs_id = next((v.id for v in cp.vector_stores.list().data if v.name == VS_NAME), None)
+    if vs_id:
+        files = [f.id for f in dp.vector_stores.files.list(vector_store_id=vs_id).data]
+        print(f"  vector store {vs_id} / files {len(files)}")
+        if APPLY:
+            for fid in files:
+                try:
+                    dp.vector_stores.files.delete(vector_store_id=vs_id, file_id=fid)
+                    dp.files.delete(fid)
+                except Exception as e:  # noqa: BLE001 - best-effort
+                    print(f"  file delete skip {fid}: {type(e).__name__}")
+            cp.vector_stores.delete(vector_store_id=vs_id)
+            print("  deleted vector store")
+        else:
+            print("  [dry-run] delete files + vector store")
+    else:
+        print(f"  {VS_NAME} は無い")
+
+    import oci
+    from jetuse_core.oci_auth import sdk_signer_args
+    from jetuse_core.settings import get_settings
+
+    s = get_settings()
+    gai = oci.generative_ai.GenerativeAiClient(**sdk_signer_args(s.oci_region))
+    for p in oci.pagination.list_call_get_all_results(
+            gai.list_generative_ai_projects, s.compartment_ocid).data:
+        if p.display_name != PROJECT_NAME or p.lifecycle_state == "DELETED":
+            continue
+        if APPLY:
+            gai.delete_generative_ai_project(p.id)
+            print(f"  deleted GenAI project {PROJECT_NAME}")
+        else:
+            print(f"  [dry-run] delete GenAI project {PROJECT_NAME}")
+
+
+def main() -> None:
+    if not APPLY:
+        print("※ dry-run（--yes を付けると実際に削除する）\n")
+    conn = connect_spike()
+    assert_target(conn)
+    cur = conn.cursor()
+    banner(f"ADB: {SCHEMA} 内のオブジェクト")
+    _run(cur, f"DROP_VECTOR_INDEX {INDEX}",
+         f"BEGIN DBMS_CLOUD_AI.DROP_VECTOR_INDEX('{INDEX}'); END;")
+    _run(cur, f"DROP_PROFILE {PROFILE}",
+         f"BEGIN DBMS_CLOUD_AI.DROP_PROFILE('{PROFILE}'); END;")
+    _run(cur, f"DROP TABLE {TABLE}", f"DROP TABLE {TABLE} PURGE")
+    _run(cur, f"DROP_CREDENTIAL {CRED}",
+         f"BEGIN DBMS_CLOUD.DROP_CREDENTIAL('{CRED}'); END;")
+    _run(cur, f"DROP_CREDENTIAL {VEC_CRED}",
+         f"BEGIN DBMS_VECTOR_CHAIN.DROP_CREDENTIAL('{VEC_CRED}'); END;")
+    conn.close()
+
+    drop_bucket()
+    drop_vector_store()
+
+    banner(f"ADB: スキーマ {SCHEMA} 自体")
+    admin = connect_admin()
+    assert_target(admin)
+    acur = admin.cursor()
+    # network ACL の ACE も principal 単位で外す（共有 ADB に残骸を残さない）
+    for host in ("inference.generativeai.ap-osaka-1.oci.oraclecloud.com",
+                 "generativeai.ap-osaka-1.oci.oraclecloud.com",
+                 "objectstorage.ap-osaka-1.oraclecloud.com"):
+        _run(acur, f"REMOVE_HOST_ACE {host}",
+             "BEGIN DBMS_NETWORK_ACL_ADMIN.REMOVE_HOST_ACE("
+             f"host => '{host}', "
+             "ace => xs$ace_type(privilege_list => xs$name_list('http'), "
+             f"principal_name => '{SCHEMA}', principal_type => xs_acl.ptype_db), "
+             "remove_empty_acl => TRUE); END;")
+    _run(acur, f"DROP USER {SCHEMA} CASCADE", f"DROP USER {SCHEMA} CASCADE")
+    admin.close()
+    print("\ndone" if APPLY else "\ndone (dry-run)")
+
+
+if __name__ == "__main__":
+    main()
