# ビルドコンテキストはリポジトリルート(jetuse_shared が api の外にあるため。P1bで共有化)。
#   <podman|docker> build --platform linux/amd64 -f packages/api/Containerfile -t <image> .
#   （配備先 Container Instance の shape は x86。ops/dev-env-up.sh が --platform を渡す）
#
# **レイヤは「変わりにくい物 → 変わりやすい物」の順に並べる。**
# 以前は jetuse_core/service/fn を COPY してから `pip install .` していたため、
# **アプリのコードを1行変えるだけで全依存の再インストール**が走っていた。
# 実測(amd64・Apple Silicon のエミュレーション下): 依存インストール 2547 秒に対し、
# 自パッケージだけなら 148 秒。直近90日の変更回数は pyproject 3 / jetuse_shared 1 に対し
# アプリコード 33 なので、大半のビルドで依存層を再利用できる。
FROM docker.io/library/python:3.12-slim
WORKDIR /app

# --- 変わりにくい層: 依存 -------------------------------------------------
# 共有ロジック(SSRFガード/Webツール/SQLサニタイズ)を pyproject の file:../jetuse_shared が
# 解決できる位置(/jetuse_shared = WORKDIR の ../jetuse_shared)へ先に配置する。
COPY packages/jetuse_shared /jetuse_shared
COPY packages/api/pyproject.toml ./
# pyproject の [project] dependencies だけを取り出して入れる。自パッケージは後段。
# tomllib は Python 3.11+ の標準ライブラリ(base image は 3.12)。
RUN python -c "import tomllib; print('\n'.join(tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']))" \
      > /tmp/requirements.txt \
 && pip install --no-cache-dir -r /tmp/requirements.txt uvicorn \
 && rm -f /tmp/requirements.txt

# --- 変わりやすい層: アプリのコード ---------------------------------------
COPY packages/api/jetuse_core ./jetuse_core
COPY packages/api/service ./service
COPY packages/api/fn ./fn
COPY packages/api/entrypoint.sh ./entrypoint.sh
# 依存は上で解決済みなので --no-deps。ここが変更のたびに走る唯一の処理。
RUN pip install --no-cache-dir --no-deps . && chmod +x entrypoint.sh

EXPOSE 8000
# RUN_DB_BOOTSTRAP=true で起動時にスキーマ用意+マイグレーション(ORMワンクリック)。既定はuvicornのみ。
CMD ["./entrypoint.sh"]
